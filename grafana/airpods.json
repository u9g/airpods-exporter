{
  "uid": "airpods",
  "title": "AirPods",
  "tags": ["airpods", "bluetooth", "audio"],
  "timezone": "browser",
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "schemaVersion": 39,
  "annotations": {"list": [
    {"builtIn": 1, "name": "Annotations & Alerts", "type": "dashboard", "datasource": {"type": "grafana", "uid": "-- Grafana --"},
     "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)"},
    {"name": "Events", "datasource": {"type": "loki", "uid": "loki"}, "enable": true, "iconColor": "purple",
     "expr": "{job=\"airpods\"} !~ \"^apps sending\"",
     "target": {"refId": "Anno", "expr": "{job=\"airpods\"} !~ \"^apps sending\"", "queryType": "range"}}
  ]},
  "panels": [
    {"type": "text", "title": "", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3},
     "options": {"mode": "markdown", "content": "**Signal** is how strongly the PC hears the AirPods' own Bluetooth broadcasts: around -50 to -65 dBm is good, below -75 dBm is weak. **Audio sent** is what Windows hands to Bluetooth, so if it is clean while you hear crackling or stutter, the problem is the radio link or the headphones, not the PC. **Call mode** means an app opened the AirPods mic, which drops all audio to phone-call quality. **What else was going on** (below) shows whether you were wearing them and using the PC, mutes, Wi-Fi traffic, driver CPU time and other Bluetooth devices; purple marks on the graphs are the monitor's events."}},

    {"type": "stat", "title": "Bluetooth link", "gridPos": {"x": 0, "y": 3, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "airpods_bluetooth_connected"}],
     "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center",
                 "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "fieldConfig": {"defaults": {"noValue": "Monitor not running",
       "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
       "mappings": [{"type": "value", "options": {"0": {"text": "Disconnected", "color": "red", "index": 0}, "1": {"text": "Connected", "color": "green", "index": 1}}}]},
       "overrides": []}},

    {"type": "stat", "title": "Signal", "gridPos": {"x": 4, "y": 3, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "airpods_signal_rssi_dbm"}],
     "options": {"colorMode": "value", "graphMode": "area", "textMode": "value", "justifyMode": "center",
                 "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "fieldConfig": {"defaults": {"unit": "suffix: dBm", "decimals": 0, "noValue": "No broadcasts",
       "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": -80}, {"color": "yellow", "value": -72}, {"color": "green", "value": -65}]}},
       "overrides": []}},

    {"type": "stat", "title": "Battery", "gridPos": {"x": 8, "y": 3, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "airpods_battery_percent"}],
     "options": {"colorMode": "value", "graphMode": "none", "textMode": "value", "justifyMode": "center",
                 "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "noValue": "Unknown",
       "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 20}, {"color": "green", "value": 40}]}},
       "overrides": []}},

    {"type": "stat", "title": "Call mode", "gridPos": {"x": 12, "y": 3, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "airpods_call_mode"}],
     "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center",
                 "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "fieldConfig": {"defaults": {
       "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
       "mappings": [{"type": "value", "options": {"0": {"text": "Off", "color": "green", "index": 0}, "1": {"text": "ON (call quality)", "color": "red", "index": 1}}}]},
       "overrides": []}},

    {"type": "stat", "title": "Audio sent", "gridPos": {"x": 16, "y": 3, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "airpods_audio_sending"}],
     "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center",
                 "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "fieldConfig": {"defaults": {
       "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
       "mappings": [{"type": "value", "options": {"0": {"text": "Nothing playing", "color": "#8e8e8e", "index": 0}, "1": {"text": "Sending", "color": "blue", "index": 1}}}]},
       "overrides": []}},

    {"type": "stat", "title": "Link drops (last 15 min)", "gridPos": {"x": 20, "y": 3, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "round(increase(airpods_bluetooth_link_changes_total[15m]))"}],
     "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center",
                 "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "fieldConfig": {"defaults": {"decimals": 0,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}},
       "overrides": []}},

    {"type": "timeseries", "title": "Signal strength at the PC", "gridPos": {"x": 0, "y": 7, "w": 12, "h": 9},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "airpods_signal_rssi_dbm", "legendFormat": "signal"},
       {"refId": "B", "expr": "min_over_time(airpods_signal_rssi_dbm[1m])", "legendFormat": "worst in last minute"}
     ],
     "fieldConfig": {"defaults": {"unit": "suffix: dBm", "min": -100, "max": -30, "decimals": 0,
       "custom": {"lineWidth": 2, "fillOpacity": 0, "spanNulls": false, "thresholdsStyle": {"mode": "area"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": -80}, {"color": "yellow", "value": -72}, {"color": "green", "value": -65}]}},
       "overrides": [{"matcher": {"id": "byName", "options": "worst in last minute"}, "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [10, 10]}}, {"id": "custom.lineWidth", "value": 1}]}]}},

    {"type": "timeseries", "title": "Audio level Windows sent", "gridPos": {"x": 12, "y": 7, "w": 12, "h": 9},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "airpods_audio_peak_dbfs", "legendFormat": "peak"},
       {"refId": "B", "expr": "airpods_audio_rms_dbfs", "legendFormat": "average (RMS)"}
     ],
     "fieldConfig": {"defaults": {"unit": "dB", "min": -100, "max": 0, "decimals": 1,
       "custom": {"lineWidth": 2, "fillOpacity": 10, "spanNulls": false}},
       "overrides": []}},

    {"type": "timeseries", "title": "Stream problems per minute", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
     "description": "Windows audio glitches mean the PC itself stalled. Clicks are sudden isolated jumps in the audio Windows sent. Link changes are Bluetooth disconnects and reconnects.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "increase(airpods_audio_glitches_total[1m])", "legendFormat": "Windows audio glitches"},
       {"refId": "B", "expr": "increase(airpods_audio_clicks_total[1m])", "legendFormat": "clicks"},
       {"refId": "C", "expr": "increase(airpods_bluetooth_link_changes_total[1m])", "legendFormat": "link changes"},
       {"refId": "D", "expr": "increase(airpods_audio_clipped_samples_total[1m])", "legendFormat": "clipped samples"}
     ],
     "fieldConfig": {"defaults": {"min": 0, "decimals": 0, "custom": {"lineWidth": 2, "fillOpacity": 10, "drawStyle": "line", "showPoints": "never"}},
       "overrides": [{"matcher": {"id": "byName", "options": "clipped samples"}, "properties": [{"id": "custom.axisPlacement", "value": "right"}]}]}},

    {"type": "timeseries", "title": "Audio delivered on time", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
     "description": "How much audio Windows delivered each second, relative to real time. 100% while playing is normal; dips while music is playing mean the PC stalled.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "airpods_audio_coverage_ratio", "legendFormat": "delivered"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1.2, "decimals": 0,
       "custom": {"lineWidth": 2, "fillOpacity": 10, "spanNulls": false, "thresholdsStyle": {"mode": "line"}},
       "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.9}]}},
       "overrides": []}},

    {"type": "state-timeline", "title": "Connection and modes", "gridPos": {"x": 0, "y": 24, "w": 24, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "up{job=\"airpods\"}", "legendFormat": "Monitor running"},
       {"refId": "B", "expr": "airpods_bluetooth_connected", "legendFormat": "Bluetooth link"},
       {"refId": "C", "expr": "airpods_output_present", "legendFormat": "Windows output present"},
       {"refId": "D", "expr": "airpods_output_is_default", "legendFormat": "Default output"},
       {"refId": "E", "expr": "airpods_audio_sending", "legendFormat": "Sending audio"},
       {"refId": "F", "expr": "airpods_call_mode", "legendFormat": "Call mode"},
       {"refId": "G", "expr": "airpods_hands_free_enabled", "legendFormat": "Hands-Free enabled"}
     ],
     "options": {"mergeValues": true, "showValue": "auto", "alignValue": "left", "rowHeight": 0.8, "legend": {"showLegend": false}},
     "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"fillOpacity": 80, "lineWidth": 0},
       "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
       "mappings": [{"type": "value", "options": {"0": {"text": "no", "color": "red", "index": 0}, "1": {"text": "yes", "color": "green", "index": 1}}}]},
       "overrides": [
         {"matcher": {"id": "byName", "options": "Call mode"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "off", "color": "green", "index": 0}, "1": {"text": "ON", "color": "red", "index": 1}}}]}]},
         {"matcher": {"id": "byName", "options": "Sending audio"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "idle", "color": "#8e8e8e", "index": 0}, "1": {"text": "sending", "color": "blue", "index": 1}}}]}]},
         {"matcher": {"id": "byName", "options": "Hands-Free enabled"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "disabled", "color": "#8e8e8e", "index": 0}, "1": {"text": "enabled", "color": "blue", "index": 1}}}]}]}
       ]}},

    {"type": "state-timeline", "title": "Apps sending audio to the AirPods", "gridPos": {"x": 0, "y": 32, "w": 24, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "airpods_app_sending", "legendFormat": "{{app}}"}],
     "options": {"mergeValues": true, "showValue": "never", "alignValue": "left", "rowHeight": 0.8, "legend": {"showLegend": false}},
     "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"fillOpacity": 80, "lineWidth": 0},
       "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
       "mappings": [{"type": "value", "options": {"1": {"text": "sending", "color": "blue", "index": 0}}}]},
       "overrides": []}},

    {"type": "row", "title": "What else was going on", "collapsed": false, "gridPos": {"x": 0, "y": 38, "w": 24, "h": 1}, "panels": []},

    {"type": "state-timeline", "title": "You, the headphones and the PC", "gridPos": {"x": 0, "y": 39, "w": 24, "h": 7},
     "description": "Worn comes from the AirPods' own broadcasts. Your head and body absorb Bluetooth, so the signal is often 20-30 dB weaker while they are on and you sit at the PC. Using the PC means keyboard or mouse input in the last minute. Muted rows catch Windows or another app (dictation tools like Wispr Flow) silencing audio.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "airpods_worn", "legendFormat": "AirPods worn"},
       {"refId": "B", "expr": "airpods_pc_idle_seconds < bool 60", "legendFormat": "Using the PC"},
       {"refId": "C", "expr": "airpods_pc_display_state", "legendFormat": "Display"},
       {"refId": "D", "expr": "airpods_output_muted", "legendFormat": "Output muted in Windows"},
       {"refId": "E", "expr": "max(airpods_app_muted)", "legendFormat": "An app muted in the mixer"},
       {"refId": "F", "expr": "airpods_pc_wifi_channel", "legendFormat": "Wi-Fi band"}
     ],
     "options": {"mergeValues": true, "showValue": "auto", "alignValue": "left", "rowHeight": 0.8, "legend": {"showLegend": false}},
     "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"fillOpacity": 80, "lineWidth": 0},
       "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}},
       "overrides": [
         {"matcher": {"id": "byName", "options": "AirPods worn"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "off", "color": "#8e8e8e", "index": 0}, "1": {"text": "on head", "color": "green", "index": 1}}}]}]},
         {"matcher": {"id": "byName", "options": "Using the PC"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "idle", "color": "#8e8e8e", "index": 0}, "1": {"text": "in use", "color": "blue", "index": 1}}}]}]},
         {"matcher": {"id": "byName", "options": "Display"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "off", "color": "#8e8e8e", "index": 0}, "1": {"text": "on", "color": "green", "index": 1}, "2": {"text": "dimmed", "color": "yellow", "index": 2}}}]}]},
         {"matcher": {"id": "byName", "options": "Output muted in Windows"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "no", "color": "green", "index": 0}, "1": {"text": "MUTED", "color": "red", "index": 1}}}]}]},
         {"matcher": {"id": "byName", "options": "An app muted in the mixer"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "no", "color": "green", "index": 0}, "1": {"text": "MUTED", "color": "red", "index": 1}}}]}]},
         {"matcher": {"id": "byName", "options": "Wi-Fi band"}, "properties": [{"id": "mappings", "value": [{"type": "range", "options": {"from": 1, "to": 14, "result": {"text": "2.4 GHz (shared with Bluetooth)", "color": "orange", "index": 0}}}, {"type": "range", "options": {"from": 15, "to": 255, "result": {"text": "5 GHz", "color": "green", "index": 1}}}]}]}
       ]}},

    {"type": "heatmap", "title": "Every broadcast's signal", "gridPos": {"x": 0, "y": 46, "w": 12, "h": 8},
     "description": "How many AirPods broadcasts the PC heard at each signal strength. The signal graph above only keeps one value per scrape; this keeps every broadcast, so brief dips show up as cells low on the chart.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (le) (increase(airpods_broadcast_rssi_dbm_bucket[$__rate_interval]))", "format": "heatmap", "legendFormat": "{{le}}"}],
     "options": {"calculate": false, "yAxis": {"axisPlacement": "left", "unit": "suffix: dBm"}, "rowsFrame": {"layout": "le"},
                 "color": {"mode": "scheme", "scheme": "Oranges", "steps": 64, "exponent": 0.5, "fill": "dark-orange", "reverse": false},
                 "cellGap": 1, "showValue": "never", "tooltip": {"mode": "single", "yHistogram": false, "showColorScale": false},
                 "legend": {"show": true}, "exemplars": {"color": "rgba(255,0,255,0.7)"}, "filterValues": {"le": 1e-9}},
     "fieldConfig": {"defaults": {}, "overrides": []}},

    {"type": "timeseries", "title": "Broadcasts the PC heard", "gridPos": {"x": 12, "y": 46, "w": 12, "h": 8},
     "description": "Fewer broadcasts per second at the same distance means the PC is missing them, a sign the radio link is struggling. Weak share is the fraction at -80 dBm or worse.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "rate(airpods_ble_broadcasts_total[1m])", "legendFormat": "heard per second"},
       {"refId": "B", "expr": "sum(increase(airpods_broadcast_rssi_dbm_bucket{le=~\"-80(.0)?\"}[1m])) / sum(increase(airpods_broadcast_rssi_dbm_count[1m]))", "legendFormat": "weak share"}
     ],
     "fieldConfig": {"defaults": {"min": 0, "decimals": 1, "custom": {"lineWidth": 2, "fillOpacity": 10, "spanNulls": false}},
       "overrides": [{"matcher": {"id": "byName", "options": "weak share"}, "properties": [{"id": "unit", "value": "percentunit"}, {"id": "max", "value": 1}, {"id": "custom.axisPlacement", "value": "right"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}]}},

    {"type": "timeseries", "title": "PC network traffic", "gridPos": {"x": 0, "y": 54, "w": 12, "h": 8},
     "description": "Most PCs' Wi-Fi card also does Bluetooth through the same antennas, so heavy Wi-Fi traffic (downloads, updates, installs) takes airtime from the AirPods, even on 5 GHz.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (type, direction) (rate(airpods_pc_network_bytes_total[$__rate_interval])) * 8", "legendFormat": "{{type}} {{direction}}"}],
     "fieldConfig": {"defaults": {"unit": "bps", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10, "spanNulls": false}}, "overrides": []}},

    {"type": "timeseries", "title": "PC CPU time", "gridPos": {"x": 12, "y": 54, "w": 12, "h": 8},
     "description": "Driver time is DPCs and interrupts. Long bursts of it (often from Wi-Fi, GPU or USB drivers) can delay the Bluetooth stack and cause crackle even when the audio Windows sent was clean. It usually shows on one CPU first.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "1 - sum(rate(airpods_pc_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) / count(airpods_pc_cpu_seconds_total{mode=\"idle\"})", "legendFormat": "busy, all CPUs"},
       {"refId": "B", "expr": "sum(rate(airpods_pc_cpu_seconds_total{mode=~\"dpc|interrupt\"}[$__rate_interval])) / count(airpods_pc_cpu_seconds_total{mode=\"idle\"})", "legendFormat": "drivers, all CPUs"},
       {"refId": "C", "expr": "max(sum by (cpu) (rate(airpods_pc_cpu_seconds_total{mode=~\"dpc|interrupt\"}[$__rate_interval])))", "legendFormat": "drivers, busiest CPU"}
     ],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "decimals": 1, "custom": {"lineWidth": 2, "fillOpacity": 0, "spanNulls": false}}, "overrides": []}},

    {"type": "state-timeline", "title": "Paired Bluetooth devices", "gridPos": {"x": 0, "y": 62, "w": 12, "h": 6},
     "description": "Another device connected to the PC's Bluetooth at the same time shares the radio with the AirPods.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "airpods_pc_bluetooth_device_connected", "legendFormat": "{{device}}"}],
     "options": {"mergeValues": true, "showValue": "auto", "alignValue": "left", "rowHeight": 0.8, "legend": {"showLegend": false}},
     "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"fillOpacity": 80, "lineWidth": 0},
       "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
       "mappings": [{"type": "value", "options": {"0": {"text": "not connected", "color": "#8e8e8e", "index": 0}, "1": {"text": "connected", "color": "blue", "index": 1}}}]},
       "overrides": []}},

    {"type": "timeseries", "title": "Volume in Windows", "gridPos": {"x": 12, "y": 62, "w": 12, "h": 6},
     "description": "The AirPods output's volume slider and each sending app's slider in the Windows volume mixer.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "airpods_output_volume_ratio", "legendFormat": "AirPods output"},
       {"refId": "B", "expr": "airpods_app_volume_ratio", "legendFormat": "{{app}}"}
     ],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "decimals": 0, "custom": {"lineWidth": 2, "fillOpacity": 0, "spanNulls": false}}, "overrides": []}},

    {"type": "logs", "title": "Events", "gridPos": {"x": 0, "y": 68, "w": 24, "h": 10},
     "description": "Everything the monitor noticed: the Bluetooth link, the AirPods being put on or taken off, the display, PC use, Wi-Fi changes, devices plugged in or removed, mutes and volume changes, and which apps are sending.",
     "datasource": {"type": "loki", "uid": "loki"},
     "targets": [{"refId": "A", "expr": "{job=\"airpods\"}", "queryType": "range"}],
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true, "dedupStrategy": "none", "prettifyLogMessage": false}}
  ]
}
